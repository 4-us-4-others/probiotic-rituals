{
  "name": "probiotic-rituals",
  "version": "0.0.1",
  "description": "probiotic-rituals",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "sass": "sass --watch --style=compressed stylesheets/scss:stylesheets/css",
    "style": "sass --watch --style=compressed stylesheets/scss:stylesheets/css"
  },
  "engines": {
    "node": ">=12.x",
    "npm": "6.9.0",
    "yarn": "1.x.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anmeisel/probiotic-rituals.git"
  },
  "author": "external pages",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/anmeisel/probiotic-rituals/issues"
  },
  "homepage": "https://github.com/anmeisel/probiotic-rituals#readme",
  "dependencies": {
    "@opennextjs/cloudflare": "^1.11.1",
    "airtable": "^0.12.2",
    "dotenv-flow": "^3.2.0",
    "fs": "^0.0.1-security",
    "hono": "^4.11.1",
    "js-yaml": "^3.13.1",
    "marked": "^17.0.1",
    "mustache": "^4.2.0",
    "stripe": "^8.128.0"
  },
  "devDependencies": {
    "eslint": "^6.8.0",
    "eslint-config-airbnb-base": "^14.1.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-prettier": "^3.1.3",
    "grunt": "^1.3.0",
    "grunt-concurrent": "^3.0.0",
    "grunt-contrib-compass": "^1.1.1",
    "grunt-contrib-uglify-es": "^3.3.0",
    "grunt-contrib-watch": "^1.1.0",
    "grunt-nodemon": "^0.4.2",
    "husky": "^7.0.1",
    "prettier": "2.0.5",
    "sass": "^1.77.4",
    "wrangler": "^4.56.0"
  },
  "nodemonConfig": {
    "env": {
      "NODE_ENV": "development"
    },
    "ext": "js,json,html,env"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "semi": false,
    "bracketSpacing": true,
    "overrides": [
      {
        "files": ["index.js", "*.js"],
        "options": {
          "tabWidth": 2,
          "semi": false,
          "singleQuote": true
        }
      },
      {
        "files": ["*.html"],
        "options": {
          "parser": "html",
          "tabWidth": 4,
          "htmlWhitespaceSensitivity": "strict",
          "jsxBracketSameLine": false
        }
      },
      {
        "files": ["*.json", "*.yaml", "*.yml"],
        "options": {
          "tabWidth": 2,
          "parser": "json"
        }
      }
    ]
  },
  "prettierIgnore": ["js/lib*", "*.min.js", "*.css", "assets*", "fonts*"],
  "eslintConfig": {
    "parserOptions": {
      "ecmaVersion": 2017
    },
    "env": {
      "es6": true,
      "browser": true,
      "jquery": true
    },
    "extends": ["eslint:recommended", "airbnb-base", "prettier"],
    "plugins": ["prettier"],
    "rules": {
      "array-bracket-spacing": [
        0,
        "always",
        {
          "objectsInArrays": false
        }
      ],
      "func-names": ["off"],
      "no-console": ["warn"],
      "no-underscore-dangle": ["off"],
      "object-curly-spacing": ["warn", "always"],
      "prefer-destructuring": ["off"],
      "prettier/prettier": ["warn"]
    }
  },
  "eslintIgnore": ["js/lib*", "assets*", "fonts*", "Gruntfile.js"],
  "packageManager": "yarn@1.22.22"
}
